---
import { Picture } from 'astro:assets';
import home from '../generated/home.json';
import banner from '../../../assets/devday-exchange-community-banner.jpg';
import '../styles/portal.css';
const base=import.meta.env.BASE_URL;
const path=(route:string)=>base+route;
---
<!doctype html>
<html lang="pt-BR" data-theme="light">
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={home.event.slogan} /><meta name="color-scheme" content="light" />
  <title>{home.event.title}</title><link rel="canonical" href={new URL(base,Astro.site)} />
  <meta property="og:title" content={home.event.title} /><meta property="og:description" content={home.event.slogan} />
 </head>
 <body class="portal-home" id="topo">
  <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
  <header class="event-header">
   <a class="event-brand" href={base}>DevDay Exchange <span>Rio 2026</span></a>
   <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="event-nav" aria-label="Abrir menu">Menu</button>
   <nav id="event-nav" aria-label="Navegação principal">
    <a href={path('prepare-se/')}>Comece aqui</a><a href="#labs">Laboratórios</a><a href={path('alo-ti/')}>Alô, TI</a><a href={path('materiais/')}>Materiais e busca</a><a href={home.repository}>GitHub ↗</a>
   </nav>
  </header>
  <main id="main-content" tabindex="-1">
   <section class="event-hero" aria-labelledby="event-title">
    <div class="hero-copy"><p class="eyebrow">Comunidade · Rio de Janeiro</p><h1 id="event-title">DevDay Exchange <span>Rio 2026</span></h1><p class="hero-description">{home.event.slogan}</p><div class="hero-actions"><a class="button" href="#labs">Escolher LAB <span aria-hidden="true">→</span></a><a class="text-action" href={home.event.registration}>Inscreva-se ↗</a></div></div>
    <Picture src={banner} formats={['avif','webp']} widths={[400,640,960,1280]} sizes="(min-width: 900px) 52vw, 100vw" alt="OpenAI DevDay Exchange Community Event, arte do encontro" loading="eager" fetchpriority="high" class="event-banner" />
   </section>
   <p class="event-details" id="encontro">{home.event.details}</p>
   <aside class="prepare-strip"><div><span aria-hidden="true">↗</span><strong>Tudo pronto para começar?</strong></div><a href={path('prepare-se/')}>Prepare seu ambiente <span aria-hidden="true">→</span></a></aside>
   <section class="lab-section reveal" id="labs" aria-labelledby="labs-title"><h2 id="labs-title">Escolha seu laboratório</h2><p class="section-description">Quatro temas independentes para experimentar e revisar uma entrega.</p><div class="lab-grid">{home.labs.map((lab,index)=><article class="lab-card"><span class="lab-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{lab.title}</h3><p>{lab.description}</p><a href={path(lab.route)}>Começar <span class="sr-only">{lab.title}</span><span aria-hidden="true">→</span></a></div></article>)}</div></section>
   <section class="local-section reveal" aria-labelledby="local-title"><div><p class="eyebrow">Demo local</p><h2 id="local-title">Alô, TI</h2><p>Service desk fictício do LAB Decisions. O modo padrão é simulado e funciona sem chamada de API.</p><a class="button" href={path('alo-ti/')}>Executar localmente <span aria-hidden="true">→</span></a></div><div class="local-explanation"><h3>Da análise à revisão humana</h3><ol><li>Escolha um cenário fictício</li><li>Analise e simule uma correção</li><li>Revise o encaminhamento</li></ol><p>A integração real de voz continua local e exige configuração separada.</p></div></section>
   <section class="materials-section reveal" id="material" aria-labelledby="materials-title"><h2 id="materials-title">Continue explorando</h2><div class="material-links">{home.materials.map(item=><a href={path(item.route)}><span>{item.title}</span><span aria-hidden="true">↗</span></a>)}</div></section>
   <section class="author-section reveal" id="sobre-mim" aria-labelledby="author-title"><img src={home.author.photo} alt={home.author.name} width="170" height="170" loading="lazy" /><div><h2 id="author-title">{home.author.name}</h2><p class="author-role">{home.author.role}</p><p>{home.author.bio}</p><nav class="social-links" aria-label="Redes da Glaucia">{home.author.socials.map(s=><a href={s.url}>{s.label} ↗</a>)}</nav></div></section>
  </main>
  <footer class="event-footer" id="seguranca"><p>Encontro organizado pela comunidade. Este material não é documentação nem produto oficial da OpenAI.</p><div><a href={home.repository+'/blob/main/LICENSE'}>Licença MIT</a><a href={home.repository+'/blob/main/THIRD_PARTY_NOTICES.md'}>Avisos de terceiros</a><a href={path('apresentadora/')}>Área da apresentadora</a><a href="#topo">Voltar ao início ↑</a></div></footer>
  <script>
   const toggle=document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
   const nav=document.querySelector<HTMLElement>('#event-nav');
   const close=()=>{toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');};
   toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open);});
   document.addEventListener('keydown',event=>{if(event.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});
   nav?.addEventListener('click',event=>{if((event.target as HTMLElement).closest('a'))close();});
   document.querySelector('.skip-link')?.addEventListener('click',()=>document.querySelector<HTMLElement>('#main-content')?.focus());
   if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('is-revealed');observer.unobserve(entry.target);}}},{threshold:0.05});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));}
  </script>
 </body>
</html>
