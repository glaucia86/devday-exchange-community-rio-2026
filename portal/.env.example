# Public configuration only. These values enter the browser bundle.
# Keep disabled until Firebase Spark, GitHub provider, verified owner UID,
# and reviewed owner-only Firestore rules are configured with authorization.
PUBLIC_PRESENTER_ENABLED=false
PUBLIC_PRESENTER_UID=
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Never add GitHub Client Secret, service-account credentials,
# OpenAI keys, passwords, or private notes to this file.
